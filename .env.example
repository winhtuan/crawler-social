# ============================================================
# crawl-fb — cấu hình crawler Facebook
# Điền giá trị sau dấu "=", KHÔNG bỏ dấu ngoặc kép nếu có.
# Dòng bắt đầu bằng "#" là ghi chú, không cần sửa.
# ============================================================

# ------------------------------------------------------------
# [KHÔNG dùng ở v1] Token Graph API — để dành cho enrich sau này.
# Browser scrape ở v1 KHÔNG cần token này. 
# ------------------------------------------------------------
FB-ACCESS-TOKEN=

# ------------------------------------------------------------
# PROXY (khuyến nghị có, để tránh bị FB flag)
# Định dạng: http://user:pass@host:port  hoặc  socks5://user:pass@host:port
# Ví dụ:    http://abc123:xyz789@45.32.1.10:8080
# Không có thì để trống -> chạy bằng IP nhà bạn (rủi ro cao hơn).
# ------------------------------------------------------------
FB_PROXY=

# ------------------------------------------------------------
# COOKIE / SESSION FACEBOOK THẬT (tùy chọn, tăng độ tin cậy)
# Cách lấy: cài extension "Cookie-Editor" trên Chrome -> mở facebook.com
#           -> bấm extension -> Export (JSON) -> dán nội dung vào file
#           .storage_state.json rồi điền đường dẫn dưới đây.
# KHÔNG dán cookie thẳng vào đây — để vào file .storage_state.json.
# ------------------------------------------------------------
FB_STORAGE_STATE=.storage_state.json

# ------------------------------------------------------------
# DELAY — khoảng nghỉ giả lập người thật giữa các lần cuộn (giây)
# base +- jitter. Mặc định 3 +- 2 => nghỉ ngẫu nhiên 1~5 giây.
# Đừng hạ thấp quá, dễ bị nhận diện bot.
# ------------------------------------------------------------
FB_DELAY_BASE=
FB_DELAY_JITTER=

# ------------------------------------------------------------
# Số post tối đa mỗi lần chạy (mặc định nếu không truyền --max-posts)
# ------------------------------------------------------------
FB_MAX_POSTS=50
