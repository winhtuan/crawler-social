# ============================================================
# crawl-fb — cấu hình crawler 
# Copy file này thành .env rồi điền giá trị.
# ============================================================

# --- Proxy (khuyến nghị) ---
# Định dạng: http://user:pass@host:port. Để trống = chạy IP nhà.
HTTP_PROXY=
PROXY_KEY_VALUE=

# --- Session Facebook (bắt buộc) ---
# Tạo bằng `python tools/login.py` hoặc export Cookie-Editor.
# Cookie `c_user` + `xs` phải có trong .storage_state.json.
FB_STORAGE_STATE=.storage_state.json

# --- Delay / limit ---
# Nghỉ giả lập người giữa các lần cuộn (giây): base ± jitter.
FB_DELAY_BASE=3.0
FB_DELAY_JITTER=2.0
FB_MAX_POSTS=50

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
AWS_REGION=ap-southeast-1

# --- Scrape Creators ---
SCRAPE_CREATORS_API_KEY=
SCRAPE_CREATORS_BASE_URL=https://api.scrapecreators.com

# --- Apify ---
APIFY_API_TOKEN=
